# --- Contact form (free, no paid API keys) ---
# Use SMTP from your own mail account.
# Gmail example: enable 2FA and create an App Password (Google Account -> Security).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-app-password
# Optional: CONTACT_INBOX=you@example.com  (defaults to email in data/portfolio.ts)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
