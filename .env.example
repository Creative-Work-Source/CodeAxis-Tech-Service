# --- Contact form ---
# Enquiries from /contact are sent by app/api/contact/route.ts through your own SMTP account.
# None of these values are shown on the website.
# Gmail example: enable 2FA and create an App Password (Google Account -> Security).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The inbox that receives enquiries (for example the company's hello@ address).
CONTACT_INBOX=
